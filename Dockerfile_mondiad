# ============================================================
# mondiad.js 多路并发访问器 Docker Image
# 基础镜像: cloakhq/cloakbrowser (含 CloakBrowser/Chromium 运行环境)
# 入口: mondiad.js
# ============================================================

FROM cloakhq/cloakbrowser:latest

LABEL description="mondiad.js 多路并发访问器"
LABEL maintainer="dev"

# 环境变量（代码内亦有默认值，运行时可用 -e 覆盖）
ENV NODE_ENV=production
# 每轮都会启动新浏览器，关闭每次启动的更新检查，避免额外网络请求和延迟
ENV CLOAKBROWSER_AUTO_UPDATE=false

# Windows 字体：从真实 Windows 的 C:\Windows\Fonts 复制到 windows-fonts/ 后构建
# （字体文件不入库；至少包含 Segoe UI, Segoe UI Light, Calibri, Marlett,
#   MS UI Gothic, Franklin Gothic, Consolas, Courier New）
COPY windows-fonts/ /usr/local/share/fonts/windows/
RUN fc-cache -f

# docker stop 时发送 SIGINT，触发脚本的清理逻辑（关闭浏览器、代理上下文）
STOPSIGNAL SIGINT

# 工作目录
WORKDIR /app

# 复制依赖清单（利用 Docker 缓存层）
COPY package.json package-lock.json ./

# 安装生产依赖
RUN npm install --omit=dev

# 复制运行时所需文件（精简）
COPY mondiad.js ./
COPY shared/ ./shared/
COPY mondiad-urls.json ./

# ============================================================
# 构建与运行
#
# 构建:
#   docker build -f Dockerfile_mondiad -t mondiad-visitor:latest .
#
# 运行（参数通过环境变量覆盖，命令行参数优先级更高）:
#   docker run -d --name=mondiad --restart=always \
#     -e VISITS_PER_DAY=250 -e CLICK_RATE=0.3 \
#     mondiad-visitor:latest
#
# 查看日志 / 停止:
#   docker logs -f mondiad
#   docker stop mondiad
#
# 可选：运行时用宿主机文件覆盖镜像内版本（调试/热更新，无需重建镜像）:
#   docker run -d --name=mondiad --restart=always \
#     -v /home/mondiad/mondiad.js:/app/mondiad.js \
#     -v /home/mondiad/mondiad-urls.json:/app/mondiad-urls.json \
#     mondiad-visitor:latest
# ============================================================

# 启动访问器
CMD ["node", "mondiad.js"]