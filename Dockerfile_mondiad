# ============================================================
# mondiad.js 多路并发访问器 Docker Image
# 基础镜像: cloakhq/cloakbrowser (含 CloakBrowser/Chromium 运行环境)
# 入口: mondiad.js
# ============================================================

FROM cloakhq/cloakbrowser:latest

LABEL description="mondiad.js 多路并发访问器"
LABEL maintainer="dev"

# 环境变量（代码内亦有默认值，运行时可用 -e 覆盖）
ENV NODE_ENV=production

# docker stop 时发送 SIGINT，触发脚本的清理逻辑（关闭浏览器、PAC、代理）
STOPSIGNAL SIGINT

# 工作目录
WORKDIR /app

# 复制依赖清单（利用 Docker 缓存层）
COPY package.json package-lock.json ./

# 安装生产依赖
RUN npm install --omit=dev

# 复制运行时所需文件（精简）
COPY mondiad.js ./
COPY shared/ ./shared/
COPY mondiad-urls.json ./

# ============================================================
# 构建与运行
#
# 构建:
#   docker build -f Dockerfile_mondiad -t mondiad-visitor:latest .
#
# 运行（参数通过环境变量覆盖，命令行参数优先级更高）:
#   docker run -d --name=mondiad --restart=always \
#     -e VISITS_PER_DAY=250 -e CLICK_RATE=0.2 \
#     mondiad-visitor:latest
#
# 查看日志 / 停止:
#   docker logs -f mondiad
#   docker stop mondiad
#
# 可选：运行时用宿主机文件覆盖镜像内版本（调试/热更新，无需重建镜像）:
#   docker run -d --name=mondiad --restart=always \
#     -v /home/mondiad/mondiad.js:/app/mondiad.js \
#     -v /home/mondiad/mondiad-urls.json:/app/mondiad-urls.json \
#     mondiad-visitor:latest
# ============================================================

# 启动访问器
CMD ["node", "mondiad.js"]